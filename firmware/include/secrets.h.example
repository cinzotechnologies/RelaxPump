// Copy to secrets.h (git-ignored), or better: use firebase/out/<ID>/secrets.h made by
// `npm run new-device` in firebase/. One file per controller.
#pragma once
#define RP_DEVICE_ID        "RP-XXXXXX"
#define RP_DEVICE_EMAIL     "rp-xxxxxx@devices.relaxpump.app"
#define RP_DEVICE_PASSWORD  "change-me"
#define RP_POP              "change-me"
#define RP_FIREBASE_API_KEY "AIza..."
#define RP_FIREBASE_DB_URL  "https://iotcinzo-default-rtdb.asia-southeast1.firebasedatabase.app"
// Board: 1 = relay module (active LOW), 2 = PCB v2 (MOSFETs, active HIGH). Same pins, 1–5 tanks.
// The serial command `board 1|2` overrides this and is kept in flash.
#define RP_BOARD 1
