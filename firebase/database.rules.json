{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'phone'])",
        "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "phone": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{10}$/)" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "devices": {
          "$deviceId": {
            ".validate": "newData.val() === true && newData.parent().parent().parent().parent().child('devices').child($deviceId).child('info/ownerUid').val() === auth.uid"
          }
        },
        "fcm": {
          "$token": { ".validate": "newData.val() === true && $token.length <= 300" }
        },
        "$other": { ".validate": false }
      }
    },

    "claims": {
      ".read": false,
      ".write": false
    },

    "claimAttempts": {
      "$deviceId": {
        "$uid": {
          ".read": false,
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)"
        }
      }
    },

    "devices": {
      "$id": {
        ".read": "auth != null && data.child('info/ownerUid').val() === auth.uid",

        "info": {
          ".read": "auth != null && auth.token.email === $id.toLowerCase() + '@devices.relaxpump.app' && auth.token.email_verified === true",
          "ownerUid": {
            ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid && root.child('claims').child($id).child('codeHash').exists() && newData.parent().parent().parent().parent().child('claimAttempts').child($id).child(auth.uid).val() === root.child('claims').child($id).child('codeHash').val()) || (data.val() === auth.uid && !newData.exists()))",
            ".validate": "newData.isString()"
          },
          "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "fw": { ".validate": "newData.isString()" },
          "maxTanks": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },

        "state": {
          ".read": "auth != null && auth.token.email === $id.toLowerCase() + '@devices.relaxpump.app' && auth.token.email_verified === true",
          ".write": "auth != null && auth.token.email === $id.toLowerCase() + '@devices.relaxpump.app' && auth.token.email_verified === true",
          ".validate": "newData.hasChildren(['online', 'pump', 'auto'])"
        },

        "config": {
          ".read": "auth != null && auth.token.email === $id.toLowerCase() + '@devices.relaxpump.app' && auth.token.email_verified === true",
          ".write": "auth != null && root.child('devices').child($id).child('info/ownerUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['tankCount', 'low', 'high', 'maxRunMin'])",
          "tankCount": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= root.child('devices').child($id).child('info/maxTanks').val()"
          },
          "low": {
            ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 80 && newData.val() + 10 <= newData.parent().child('high').val()"
          },
          "high": { ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= 100" },
          "maxRunMin": { ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 180" },
          "tanks": {
            "$i": {
              "emptyCm": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 500" },
              "fullCm": { ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= 500" },
              "litres": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999" },
              "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 14" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        },

        "cmd": {
          ".read": "auth != null && auth.token.email === $id.toLowerCase() + '@devices.relaxpump.app' && auth.token.email_verified === true",
          ".write": "auth != null && ((root.child('devices').child($id).child('info/ownerUid').val() === auth.uid && newData.exists()) || (auth.token.email === $id.toLowerCase() + '@devices.relaxpump.app' && auth.token.email_verified === true && !newData.exists()))",
          ".validate": "newData.hasChild('ts')",
          "pump": { ".validate": "newData.isBoolean()" },
          "auto": { ".validate": "newData.isBoolean()" },
          "valve": {
            ".validate": "newData.hasChildren(['i', 'open'])",
            "i": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 8" },
            "open": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          },
          "ts": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
          "$other": { ".validate": false }
        },

        "events": {
          ".indexOn": ["ts"],
          "$eventId": {
            ".write": "auth != null && auth.token.email === $id.toLowerCase() + '@devices.relaxpump.app' && auth.token.email_verified === true && !data.exists()",
            ".validate": "newData.hasChildren(['type', 'tank', 'ts']) && newData.child('type').isString() && newData.child('type').val().matches(/^(full|low|pump_on|pump_off|dry_run|timeout|sensor)$/)"
          }
        },

        "usage": {
          "$day": {
            ".write": "auth != null && auth.token.email === $id.toLowerCase() + '@devices.relaxpump.app' && auth.token.email_verified === true",
            ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.hasChildren(['litres', 'pumpMin'])"
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
