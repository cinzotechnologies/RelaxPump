{
  "name": "relaxpump-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy && opennextjs-cloudflare deploy --env admin",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --strict-vars=false cloudflare-env.d.ts",
    "db:migrate": "wrangler d1 migrations apply relaxpump-web --local",
    "db:migrate:remote": "wrangler d1 migrations apply relaxpump-web --remote",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:visual": "playwright test",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:seed-file": "tsx scripts/gen-seed.ts",
    "deploy:jobs": "wrangler deploy -c jobs/wrangler.jsonc"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
