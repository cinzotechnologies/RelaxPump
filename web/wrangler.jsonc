{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relaxpump-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Public site + admin panel: one Worker, two hostnames (lib/host.ts, docs/website-setup.md).
  "routes": [
    { "pattern": "relaxpump.cinzotechnologies.com", "custom_domain": true },
    { "pattern": "relaxpumpadmin.cinzotechnologies.com", "custom_domain": true },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "relaxpump-web",
      // Replace with the id from `wrangler d1 create relaxpump-web` (docs/website-setup.md).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "relaxpump-media" }],
  "vars": {
    // Comma-separated emails allowed into the admin (Cloudflare Access checks them first).
    "ADMIN_EMAILS": "cinzotechnologies@gmail.com,hacheh976@gmail.com",
    // Hostnames. On localhost both are ignored and everything runs on one host.
    "SITE_URL": "https://relaxpump.cinzotechnologies.com",
    "ADMIN_HOST": "relaxpumpadmin.cinzotechnologies.com",
    // ACCESS_TEAM_DOMAIN and ACCESS_AUD are secrets (`wrangler secret put`), so `next dev`
    // keeps the local sign-in.
  },
}
