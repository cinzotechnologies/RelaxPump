{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'phone'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{10}$/)"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "devices": {
          "$deviceId": {
            ".validate": "newData.val() === true && newData.parent().parent().parent().parent().child('devices').child($deviceId).child('info/ownerUid').val() === auth.uid"
          }
        },
        "fcm": {
          "$token": {
            ".validate": "newData.val() === true && $token.length <= 300"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "claims": {
      ".read": false,
      ".write": false
    },
    "claimAttempts": {
      "$deviceId": {
        "$uid": {
          ".read": false,
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)"
        }
      }
    },
    "installerPins": {
      "$id": {
        ".read": false,
        ".write": "newData.exists() && auth != null && root.child('devices').child($id).child('info/ownerUid').val() === auth.uid && (!root.child('installerPins').child($id).exists() || (root.child('pinAttempts').child($id).child(auth.uid).child('hash').val() === root.child('installerPins').child($id).child('hash').val() && root.child('pinAttempts').child($id).child(auth.uid).child('ts').val() > now - 900000))",
        ".validate": "newData.hasChildren(['hash'])",
        "hash": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "pinAttempts": {
      "$deviceId": {
        "$uid": {
          ".read": false,
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['hash', 'ts'])",
          "hash": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)"
          },
          "ts": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 60000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "pinChecks": {
      "$deviceId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && auth != null && root.child('devices').child($deviceId).child('info/ownerUid').val() === auth.uid && (!newData.exists() || (!root.child('installerPins').child($deviceId).exists() || (root.child('pinAttempts').child($deviceId).child(auth.uid).child('hash').val() === root.child('installerPins').child($deviceId).child('hash').val() && root.child('pinAttempts').child($deviceId).child(auth.uid).child('ts').val() > now - 900000)))",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "devices": {
      "$id": {
        ".read": "auth != null && root.child('devices').child($id).child('info/ownerUid').val() === auth.uid",
        "info": {
          ".read": "auth != null && auth.token.email === $id.toLowerCase() + '@devices.relaxpump.app' && auth.token.email_verified === true",
          "ownerUid": {
            ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid && root.child('claims').child($id).child('codeHash').exists() && newData.parent().parent().parent().parent().child('claimAttempts').child($id).child(auth.uid).val() === root.child('claims').child($id).child('codeHash').val()) || (data.val() === auth.uid && !newData.exists()))",
            ".validate": "newData.isString()"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "fw": {
            ".write": "auth != null && auth.token.email === $id.toLowerCase() + '@devices.relaxpump.app' && auth.token.email_verified === true",
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "board": {
            ".write": "auth != null && auth.token.email === $id.toLowerCase() + '@devices.relaxpump.app' && auth.token.email_verified === true",
            ".validate": "newData.isString() && newData.val().matches(/^v[12]$/)"
          },
          "maxTanks": {
            ".write": "auth != null && auth.token.email === $id.toLowerCase() + '@devices.relaxpump.app' && auth.token.email_verified === true",
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
          },
          "$other": {
            ".validate": false
          }
        },
        "state": {
          ".read": "auth != null && auth.token.email === $id.toLowerCase() + '@devices.relaxpump.app' && auth.token.email_verified === true",
          ".write": "auth != null && auth.token.email === $id.toLowerCase() + '@devices.relaxpump.app' && auth.token.email_verified === true",
          ".validate": "newData.hasChildren(['online', 'pump', 'auto'])"
        },
        "config": {
          ".read": "auth != null && auth.token.email === $id.toLowerCase() + '@devices.relaxpump.app' && auth.token.email_verified === true",
          ".write": "auth != null && root.child('devices').child($id).child('info/ownerUid').val() === auth.uid && (!root.child('installerPins').child($id).exists() || (root.child('pinAttempts').child($id).child(auth.uid).child('hash').val() === root.child('installerPins').child($id).child('hash').val() && root.child('pinAttempts').child($id).child(auth.uid).child('ts').val() > now - 900000))",
          ".validate": "newData.hasChildren(['tankCount', 'tanks', 'low', 'high', 'maxRunMin']) && newData.child('tanks/0').exists() && (newData.child('tankCount').val() <= 1 || newData.child('tanks/1').exists()) && (newData.child('tankCount').val() <= 2 || newData.child('tanks/2').exists()) && (newData.child('tankCount').val() <= 3 || newData.child('tanks/3').exists()) && (newData.child('tankCount').val() <= 4 || newData.child('tanks/4').exists())",
          "low": {
            ".write": "auth != null && root.child('devices').child($id).child('info/ownerUid').val() === auth.uid",
            ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 80 && newData.val() + 10 <= newData.parent().child('high').val()"
          },
          "high": {
            ".write": "auth != null && root.child('devices').child($id).child('info/ownerUid').val() === auth.uid",
            ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= 100"
          },
          "maxRunMin": {
            ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 180"
          },
          "tankCount": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5 && newData.val() <= root.child('devices').child($id).child('info/maxTanks').val()"
          },
          "tanks": {
            "$i": {
              ".validate": "$i.matches(/^[0-4]$/) && ($i === '0' || ($i === '1' && newData.parent().parent().child('tankCount').val() >= 2) || ($i === '2' && newData.parent().parent().child('tankCount').val() >= 3) || ($i === '3' && newData.parent().parent().child('tankCount').val() >= 4) || ($i === '4' && newData.parent().parent().child('tankCount').val() >= 5)) && newData.hasChildren(['emptyCm', 'fullCm'])",
              "name": {
                ".write": "auth != null && root.child('devices').child($id).child('info/ownerUid').val() === auth.uid",
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 14"
              },
              "litres": {
                ".write": "auth != null && root.child('devices').child($id).child('info/ownerUid').val() === auth.uid",
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
              },
              "emptyCm": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 500"
              },
              "fullCm": {
                ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= 500"
              },
              "heightFt": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "main": {
            ".validate": "newData.hasChildren(['enabled', 'minPct'])",
            "enabled": {
              ".validate": "newData.isBoolean()"
            },
            "litres": {
              ".write": "auth != null && root.child('devices').child($id).child('info/ownerUid').val() === auth.uid",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
            },
            "emptyCm": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 800"
            },
            "fullCm": {
              ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= 500"
            },
            "minPct": {
              ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 40"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "cmd": {
          ".read": "auth != null && auth.token.email === $id.toLowerCase() + '@devices.relaxpump.app' && auth.token.email_verified === true",
          ".write": "auth != null && ((root.child('devices').child($id).child('info/ownerUid').val() === auth.uid && newData.exists()) || (auth != null && auth.token.email === $id.toLowerCase() + '@devices.relaxpump.app' && auth.token.email_verified === true && !newData.exists()))",
          ".validate": "newData.hasChild('ts')",
          "pump": {
            ".validate": "newData.isBoolean()"
          },
          "auto": {
            ".validate": "newData.isBoolean()"
          },
          "pumpCheck": {
            ".validate": "newData.isBoolean()"
          },
          "valve": {
            ".validate": "newData.hasChildren(['i', 'open'])",
            "i": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4"
            },
            "open": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          },
          "test": {
            ".validate": "newData.hasChildren(['port', 'ms'])",
            "port": {
              ".validate": "newData.isString() && newData.val().matches(/^(V[1-5]|PUMP)$/)"
            },
            "ms": {
              ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 3000"
            },
            "$other": {
              ".validate": false
            }
          },
          "ts": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          }
        },
        "events": {
          ".indexOn": [
            "ts"
          ],
          "$eventId": {
            ".write": "auth != null && auth.token.email === $id.toLowerCase() + '@devices.relaxpump.app' && auth.token.email_verified === true && !data.exists()",
            ".validate": "newData.hasChildren(['type', 'tank', 'ts']) && newData.child('type').isString() && newData.child('type').val().matches(/^(full|low|pump_on|pump_off|dry_run|timeout|sensor|main_low|board_error|check_done)$/)"
          }
        },
        "usage": {
          "$day": {
            ".write": "auth != null && auth.token.email === $id.toLowerCase() + '@devices.relaxpump.app' && auth.token.email_verified === true",
            ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.hasChildren(['litres', 'pumpMin'])"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
